# Prisma Postgres (Europe Paris). Ne jamais committer le fichier .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# dev : pas d'écran de connexion. entra : Microsoft 365, voir docs/DEPLOIEMENT.md.
# AUTH_MODE=dev est refusé si NODE_ENV=production.
AUTH_MODE="dev"

# Défaut si vide : Alexandre Sankara (u_alexandre_sankara)
DEV_USER_ID="u_alexandre_sankara"

# Dossier des données d'origine, celui qui contient donnees/.
# Utilisé seulement par npm run db:import et npm run db:dry.
# L'application, une fois lancée, ne lit pas ce dossier.
# Exemple : LEGACY_DATA_DIR="C:/chemin/vers/donnees-origine"
LEGACY_DATA_DIR=""

# Réservés au mode entra. Laisser vides tant que la connexion Microsoft n'est pas branchée.
AUTH_SECRET=""
AUTH_MICROSOFT_ID=""
AUTH_MICROSOFT_SECRET=""
AUTH_MICROSOFT_TENANT_ID=""
